{
  "name": "@CC/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:local": "turso dev --db-file local.db",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate:challenges": "bun run ./src/generate-challenges-content.ts",
    "db:sync:challenges:index": "bun run ./src/sync-challenges-index.ts",
    "db:seed:challenges": "bun run ./src/seed-challenges.ts",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@CC/env": "workspace:*",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@CC/config": "workspace:*",
    "prisma": "^7.8.0",
    "typescript": "catalog:"
  }
}
