{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./server/api/schemas": "./src/server/api/schemas.ts"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "check-types": "node -e \"require('fs').rmSync('.next/dev/types',{recursive:true,force:true})\" && next typegen && tsc --noEmit",
    "start": "next start"
  },
  "dependencies": {
    "@kodan/auth": "workspace:*",
    "@kodan/db": "workspace:*",
    "@kodan/env": "workspace:*",
    "@kodan/ui": "workspace:*",
    "@prisma/client": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "catalog:",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "catalog:",
    "next": "^16.2.0",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kodan/config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "1.3.14",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "reactDoctor": {
    "ignore": {
      "overrides": [
        {
          "files": [
            "src/app/desafios/ema-challenge-card-helpers.ts",
            "src/app/desafios/ema-challenge-card.tsx",
            "src/app/treinar/*/train-arena-client.tsx",
            "src/app/entry-gate.tsx",
            "src/components/header.tsx",
            "src/components/mode-toggle.tsx",
            "src/components/nav-link.tsx",
            "src/components/providers.tsx",
            "src/components/theme-provider.tsx",
            "src/components/user-menu.tsx",
            "src/lib/local-user.ts",
            "src/lib/rating.ts"
          ],
          "rules": [
            "deslop/unused-file"
          ]
        },
        {
          "files": [
            "src/app/zen/ZenPlaygroundClient.tsx"
          ],
          "rules": [
            "deslop/unused-file",
            "react-doctor/no-giant-component",
            "react-doctor/prefer-useReducer"
          ]
        }
      ]
    }
  }
}
