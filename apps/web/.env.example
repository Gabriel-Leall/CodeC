# Para integrar banco e autenticação, preencha:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# BETTER_AUTH_SECRET="substitua-por-um-segredo-com-pelo-menos-32-caracteres"
# BETTER_AUTH_URL="http://localhost:3001"
# CORS_ORIGIN="http://localhost:3001"

# Opcionais no modo integrado: feedback de IA e migração do SQLite legado.
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openai/gpt-4o-mini"
# LEGACY_SQLITE_URL="file:../../local.db"
